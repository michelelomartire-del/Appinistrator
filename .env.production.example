# ---------------------------------------------------------------------------
# CRM EffeBi — configurazione di PRODUZIONE (esempio senza valori reali)
# Copiare in .env sul server, compilare e limitare i permessi: chmod 600 .env
# Nessun valore reale va committato.
# ---------------------------------------------------------------------------

NODE_ENV=production
PORT=4000
APP_URL=https://crm.studio-effebi.example

# --- Database (obbligatorio in produzione: PGlite non è ammesso) ------------
# PostgreSQL in regione UE. Con provider gestito usare la stringa "pooled"
# se disponibile e DATABASE_SSL=true.
DATABASE_URL=postgresql://effebi:__PASSWORD__@127.0.0.1:5432/effebi_crm
DATABASE_SSL=false

# Cartella dati persistenti (documenti e, se usato, database embedded).
# Deve stare FUORI dal checkout git e appartenere all'utente del servizio.
DATA_DIR=/var/lib/effebi-crm

# --- Sicurezza --------------------------------------------------------------
# 32 byte casuali in base64: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
APP_ENCRYPTION_KEY=__CHIAVE_BASE64_32_BYTE__
SESSION_TTL_HOURS=8
# 1 proxy davanti all'app (nginx). Mettere 0 se l'app è esposta direttamente.
TRUST_PROXY=1

# --- Documenti --------------------------------------------------------------
# local (cartella DATA_DIR/documenti) oppure supabase (bucket privato UE)
STORAGE_DRIVER=local
# SUPABASE_URL=https://xxxx.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=__SOLO_SERVER__
# SUPABASE_STORAGE_BUCKET=documenti-crm

# --- Demo -------------------------------------------------------------------
# SEMPRE false in produzione: il server rifiuta di avviarsi con DEMO_MODE=true.
DEMO_MODE=false

# --- Backend mail: nessuna integrazione prevista nella v1 -------------------
