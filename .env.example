# ---------------------------------------------------------------------------
# CRM EffeBi — variabili d'ambiente (esempio, nessun valore reale)
# Copiare in .env e compilare. NON committare mai .env.
# ---------------------------------------------------------------------------

# Ambiente: development | production | test
NODE_ENV=development

# Porta HTTP del server (in produzione tipicamente 4000 dietro reverse proxy)
PORT=4000

# URL pubblico dell'applicazione (usato per cookie/origini consentite)
APP_URL=http://localhost:4000

# --- Database ---------------------------------------------------------------
# Con DATABASE_URL impostata l'app usa PostgreSQL (Supabase o Postgres gestito
# in regione UE). Se assente, usa un PostgreSQL embedded (PGlite) in .data/ —
# solo per sviluppo/demo, NON per dati reali.
# DATABASE_URL=postgresql://utente:password@host:5432/effebi_crm?sslmode=require
# DATABASE_SSL=true

# Cartella dati locale (documenti e, senza DATABASE_URL, il database embedded)
DATA_DIR=.data

# --- Sicurezza --------------------------------------------------------------
# Chiave per cifratura dei segreti MFA a riposo. Generare con:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
APP_ENCRYPTION_KEY=

# Durata sessione in ore (default 8)
SESSION_TTL_HOURS=8

# Numero di proxy fidati davanti all'app (per IP reali); default 1 in produzione
TRUST_PROXY=1

# --- Storage documenti ------------------------------------------------------
# local | supabase
STORAGE_DRIVER=local
# SUPABASE_URL=https://xxxx.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=   # solo lato server, mai nel browser
# SUPABASE_STORAGE_BUCKET=documenti-crm

# --- Demo / sviluppo --------------------------------------------------------
# Mostra il banner "dati sintetici" e la nota credenziali demo in login.
DEMO_MODE=true

# Credenziali account demo creati da `npm run seed:demo` (solo demo locale).
DEMO_ADMIN_EMAIL=demo@effebi.invalid
DEMO_ADMIN_PASSWORD=EffeBi-Demo-2026!
